generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


//Enums
enum UserRole {
  MENTOR
  ENTREPRENEUR
}

enum SocialPlatform {
  LINKEDIN
  GITHUB
  X
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  WEBSITE
  PORTFOLIO
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ProjectStage {
  IDEE
  MVP
  SEED
  CROISSANCE
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}



//************** Modèle User************
model User {
  id                String   @id @default(cuid())

  firstName         String
  lastName          String

  email             String   @unique
  password          String

  role              UserRole

  profilePicture    String?
  coverPicture      String?

  bio               String?  @db.Text

  birthDate         DateTime?

  country           String?
  city              String?

  isEmailVerified   Boolean  @default(false)
  isActive          Boolean  @default(true)
  profileCompleted Boolean @default(false)
  lastLoginAt   DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt


  //****************** Relations pour User*************
  languages         UserLanguage[]
  skills            UserSkill[]
  availabilities    Availability[]
  socialLinks       SocialLink[]
  documents         Document[]
  cv                CV?
  mentor            Mentor?
  entrepreneur      Entrepreneur?
}

//************Tables pour User *********
//langues
model Language {
  id      String @id @default(cuid())
  name    String @unique

  users   UserLanguage[]
}

model UserLanguage {
  userId      String
  languageId  String

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([userId, languageId])
}

//compétences
model Skill {
  id      String @id @default(cuid())
  name    String @unique

  users   UserSkill[]
}


model UserSkill {
  userId   String
  skillId  String

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill    Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

//disponibilités
model Availability {
  id      String @id @default(cuid())
  slot    String   // ex: "Matin (8h-12h)"

  userId  String
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


//rx sociaux
model SocialLink {
  id         String @id @default(cuid())

  platform   SocialPlatform
  url        String

  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//CV
model CV {
  id          String   @id @default(cuid())

  fileName    String
  fileUrl     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String   @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//document
model Document {
  id          String   @id @default(cuid())

  title       String
  type        String
  fileName    String
  fileUrl     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


//************** Modèle Mentor ************
model Mentor {
  id                String   @id @default(cuid())

  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  profession        String?
  yearsOfExperience String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  //****************** Relations pour Mentor*************
  domains           MentorDomain[]
  mentorships      Mentorship[]
}

//************** Modèle Entrepreneur ************
model Entrepreneur {
  id                String   @id @default(cuid())

  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  profession        String?
  level             String?
  lookingFor        String[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  domains           EntrepreneurDomain[]
  mentorships      Mentorship[]
  startups          Startup[]
  joinRequests      ProjectJoinRequest[]
}

//************Table pivot Domaines *********
model Domain {
  id            String @id @default(cuid())
  name          String @unique

  mentors       MentorDomain[]
  entrepreneurs EntrepreneurDomain[]
}

model MentorDomain {
  mentorId  String
  domainId  String

  mentor    Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  domain    Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([mentorId, domainId])
}

model EntrepreneurDomain {
  entrepreneurId String
  domainId       String

  entrepreneur   Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)
  domain         Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([entrepreneurId, domainId])
}

//***********table d'assocaion entre entrepreneur et mentor
model Mentorship {
  id               String @id @default(cuid())
  startupId        String?
  startup          Startup? @relation(fields: [startupId], references: [id], onDelete: SetNull)

  mentorId         String
  entrepreneurId   String

  mentor           Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  entrepreneur     Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)

  status           MentorshipStatus @default(PENDING)

  message          String? @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


//***********model startup**********
model Startup {
  id             String       @id @default(cuid())

  name           String
  description    String       @db.Text
  stage          ProjectStage @default(IDEE)
  domain         String
  isPublic       Boolean      @default(true)
  isRecruiting   Boolean      @default(false)
  needs          String[]

  entrepreneurId String
  entrepreneur   Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

 //relations
  mentorships    Mentorship[]
  steps          StartupStep[]
  joinRequests   ProjectJoinRequest[]
}

//*****model étapes startup********
model StartupStep {
  id          String   @id @default(cuid())

  title       String
  completed   Boolean  @default(false)
  order       Int

  startupId   String
  startup     Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//********Modèle Demande de rejoindre une startup**********
model ProjectJoinRequest {
  id          String            @id @default(cuid())
  message     String?           @db.Text
  status      JoinRequestStatus @default(PENDING)
  rejectionReason  String?           @db.Text

  startupId   String
  startup     Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)

  requesterId String
  requester   Entrepreneur @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([startupId, requesterId])
}
