generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


//Enums
enum UserRole {
  MENTOR
  ENTREPRENEUR
}

enum SocialPlatform {
  LINKEDIN
  GITHUB
  X
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  WEBSITE
  PORTFOLIO
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ProjectStage {
  IDEE
  MVP
  SEED
  CROISSANCE
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum WorkspaceDocumentType {
  PDF
  EXCEL
  WORD
  IMAGE
  OTHER
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ResourceType {
  DOCUMENT
  VIDEO
  LINK
}

enum PostTag {
  MILESTONE
  QUESTION
  UPDATE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

//************** Modèle User************
model User {
  id                String   @id @default(cuid())

  firstName         String
  lastName          String

  email             String   @unique
  password          String?  // nullable : un compte Google n'a pas de mot de passe

  role              UserRole

  authProvider      AuthProvider @default(LOCAL)
  googleId          String?      @unique

  profilePicture    String?
  coverPicture      String?

  bio               String?  @db.Text

  birthDate         DateTime?

  country           String?
  city              String?

  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?   @unique // HASH du token
  emailVerificationExpires DateTime?

  isActive          Boolean  @default(true)
  isLocked          Boolean  @default(false)
  failedLoginAttempts Int    @default(0)

  passwordResetToken   String?   @unique // HASH du token
  passwordResetExpires DateTime?

  profileCompleted Boolean @default(false)
  lastLoginAt   DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt


  //****************** Relations pour User*************
  languages         UserLanguage[]
  skills            UserSkill[]
  availabilities    Availability[]
  socialLinks       SocialLink[]
  documents         Document[]
  cv                CV?
  mentor            Mentor?
  entrepreneur      Entrepreneur?
  messages          Message[]
  workspaceDocuments WorkspaceDocument[]
  sessionsCreated      Session[]            @relation("SessionCreatedBy")
  sessionParticipations SessionParticipant[] @relation("SessionParticipations")
  tasksAssigned Task[] @relation("TaskAssignee")
  resourcesAuthored Resource[]     @relation("ResourceAuthor")
  resourceSaves     ResourceSave[] @relation("ResourceSavedBy")
  posts         Post[]        @relation("PostAuthor")
  postComments  PostComment[] @relation("PostCommentAuthor")
  postLikes     PostLike[]    @relation("PostLikedBy")
  postSaves     PostSave[]    @relation("PostSavedBy")
}

//************Tables pour User *********
//langues
model Language {
  id      String @id @default(cuid())
  name    String @unique

  users   UserLanguage[]
}

model UserLanguage {
  userId      String
  languageId  String

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([userId, languageId])
}

//compétences
model Skill {
  id      String @id @default(cuid())
  name    String @unique

  users   UserSkill[]
}


model UserSkill {
  userId   String
  skillId  String

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill    Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

//disponibilités
model Availability {
  id      String @id @default(cuid())
  slot    String   // ex: "Matin (8h-12h)"

  userId  String
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


//rx sociaux
model SocialLink {
  id         String @id @default(cuid())

  platform   SocialPlatform
  url        String

  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//CV
model CV {
  id          String   @id @default(cuid())

  fileName    String
  fileUrl     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String   @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//document
model Document {
  id          String   @id @default(cuid())

  title       String
  type        String
  fileName    String
  fileUrl     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


//************** Modèle Mentor ************
model Mentor {
  id                String   @id @default(cuid())

  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  profession        String?
  yearsOfExperience String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  //****************** Relations pour Mentor*************
  domains           MentorDomain[]
  mentorships      Mentorship[]
}

//************** Modèle Entrepreneur ************
model Entrepreneur {
  id                String   @id @default(cuid())

  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  profession        String?
  level             String?
  lookingFor        String[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  domains           EntrepreneurDomain[]
  mentorships      Mentorship[]
  startups          Startup[]
  joinRequests      ProjectJoinRequest[]
}

//************Table pivot Domaines *********
model Domain {
  id            String @id @default(cuid())
  name          String @unique

  mentors       MentorDomain[]
  entrepreneurs EntrepreneurDomain[]
}

model MentorDomain {
  mentorId  String
  domainId  String

  mentor    Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  domain    Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([mentorId, domainId])
}

model EntrepreneurDomain {
  entrepreneurId String
  domainId       String

  entrepreneur   Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)
  domain         Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([entrepreneurId, domainId])
}

//***********table d'assocaion entre entrepreneur et mentor
model Mentorship {
  id               String @id @default(cuid())
  startupId        String?
  startup          Startup? @relation(fields: [startupId], references: [id], onDelete: SetNull)

  mentorId         String
  entrepreneurId   String

  mentor           Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  entrepreneur     Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)

  status           MentorshipStatus @default(PENDING)

  message          String? @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  messages         Message[]
  objectives  Objective[]
  workspaceDocuments WorkspaceDocument[]
  sessions Session[]
  tasks Task[]
  aiSummaryCache        Json?
  aiSummaryGeneratedAt  DateTime?
  aiSummaryAttempts       Int       @default(0)
  aiSummaryWindowStart    DateTime?

  mentorMatchesCache       Json?
  mentorMatchesGeneratedAt DateTime?
  mentorMatchesAttempts     Int       @default(0)
  mentorMatchesWindowStart  DateTime?

  swotCache        Json?
  swotGeneratedAt  DateTime?
  swotAttempts     Int       @default(0)
  swotWindowStart  DateTime?

  mentorBriefingCache        Json?
  mentorBriefingGeneratedAt  DateTime?
  mentorBriefingAttempts     Int       @default(0)
  mentorBriefingWindowStart  DateTime?

  aiChatSessions AIChatSession[]

  dashboardSuggestionsCache       Json?
  dashboardSuggestionsGeneratedAt DateTime?
  dashboardSuggestionsAttempts    Int       @default(0)
  dashboardSuggestionsWindowStart DateTime?
}


//***********model startup**********
model Startup {
  id             String       @id @default(cuid())

  name           String
  description    String       @db.Text
  stage          ProjectStage @default(IDEE)
  domain         String
  isPublic       Boolean      @default(true)
  isRecruiting   Boolean      @default(false)
  needs          String[]

  entrepreneurId String
  entrepreneur   Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

 //relations
  mentorships    Mentorship[]
  steps          StartupStep[]
  joinRequests   ProjectJoinRequest[]
}

//*****model étapes startup********
model StartupStep {
  id          String   @id @default(cuid())

  title       String
  completed   Boolean  @default(false)
  order       Int

  startupId   String
  startup     Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//********Modèle Demande de rejoindre une startup**********
model ProjectJoinRequest {
  id          String            @id @default(cuid())
  message     String?           @db.Text
  status      JoinRequestStatus @default(PENDING)
  rejectionReason  String?           @db.Text

  startupId   String
  startup     Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)

  requesterId String
  requester   Entrepreneur @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([startupId, requesterId])
}


//*****model message du workspace********
model Message {
  id             String   @id @default(cuid())

  content        String   @db.Text

  mentorshipId   String
  mentorship     Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([mentorshipId, createdAt])
}

//***modèle Objectif dans workspace***
model Objective {
  id           String   @id @default(cuid())
  title        String
  category     String
  progress     Int      @default(0)

  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mentorshipId])
}

//***modèle document pour le workspace ***
model WorkspaceDocument {
  id            String                @id @default(cuid())

  name          String
  fileType      WorkspaceDocumentType
  fileUrl       String
  sizeBytes     Int
  sessionNumber Int?

  mentorshipId  String
  mentorship    Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  uploadedById  String
  uploadedBy    User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([mentorshipId, createdAt])
}

//***modèle session***
model Session {
  id              String        @id @default(cuid())
  number          Int
  scheduledAt     DateTime
  durationMinutes Int
  status          SessionStatus @default(SCHEDULED)

  meetingUrl      String?
  agenda          String?       @db.Text
  rawNotes        String?       @db.Text
  aiSummary       Json?

  mentorshipId    String
  mentorship      Mentorship    @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  createdById     String
  createdBy       User          @relation("SessionCreatedBy", fields: [createdById], references: [id])
  reminderSentAt DateTime?

  participants    SessionParticipant[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([mentorshipId, scheduledAt])
}

//**modèle participant dans une session***
model SessionParticipant {
  id         String   @id @default(cuid())

  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("SessionParticipations", fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([sessionId, userId])
}

//***modèle tâche dans workspace***
model Task {
  id           String   @id @default(cuid())
  title        String
  status       String   @default("todo")   // "todo" | "done"
  priority     String                      // "high" | "medium" | "low"
  dueDate      DateTime

  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  assigneeId   String
  assignee     User       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mentorshipId])
}

//****Model Ressource****
model Resource {
  id            String       @id @default(cuid())
  type          ResourceType
  title         String

  fileUrl       String?
  fileName      String?
  sizeBytes     Int?

  url           String?
  durationLabel String?

  authorId      String
  author        User         @relation("ResourceAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  saves         ResourceSave[]

  @@index([type, createdAt])
}

model ResourceSave {
  id         String   @id @default(cuid())

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("ResourceSavedBy", fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
}


//****modele AI CHAT SESSION**** 
model AIChatSession {
  id           String    @id @default(cuid())
  mentorshipId String
  userId       String
  history      Json      @default("[]")
  attempts     Int       @default(0)
  windowStart  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  @@unique([mentorshipId, userId])
}


//****modèle Post***
model Post {
  id        String   @id @default(cuid())
  content   String   @db.Text
  tag       PostTag?

  authorId  String
  author    User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  PostComment[]
  likes     PostLike[]
  saves     PostSave[]

  @@index([createdAt])
}


//***modèle commentaire***
model PostComment {
  id        String   @id @default(cuid())
  content   String   @db.Text

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([parentId])
}

//****modèle like****
model PostLike {
  id        String   @id @default(cuid())

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation("PostLikedBy", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}


//****modèle save****
model PostSave {
  id        String   @id @default(cuid())

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation("PostSavedBy", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}